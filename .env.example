# Page Pulse Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3000
NODE_ENV=development

# Caching — how long audit results are cached (seconds)
CACHE_TTL_SECONDS=300

# HTTP Fetch — timeout per website request (milliseconds)
REQUEST_TIMEOUT_MS=5000

# Rate Limiting — per IP
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Concurrency — max simultaneous audits
MAX_CONCURRENT_AUDITS=50
